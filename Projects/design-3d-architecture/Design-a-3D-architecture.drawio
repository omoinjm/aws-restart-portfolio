<mxfile host="app.diagrams.net" version="29.3.7">
  <diagram name="3D E-Commerce Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Users -->
        <mxCell id="users" value="Users / Clients" style="shape=mxgraph.aws4.user;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
