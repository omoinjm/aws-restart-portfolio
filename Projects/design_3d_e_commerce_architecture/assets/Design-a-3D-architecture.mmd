EC2 --> RDS
EC2 --> DYNAMODB
EC2 --> S3

LAMBDA --> DYNAMODB
LAMBDA --> S3

%% Monitoring
EC2 --> CW
LAMBDA --> CW
RDS --> CW
DYNAMODB --> CW
S3 --> CW
ALB --> CW
CF --> CW
R53 --> CW

%% IAM Controls
IAM --> EC2
IAM --> LAMBDA
IAM --> RDS
IAM --> S3
