---
import fs from 'node:fs';
import path from 'node:path';

const navPath = path.join(process.cwd(), 'nav.json');
const nav = JSON.parse(fs.readFileSync(navPath, 'utf8'));

function mdToHref(mdPath) {
  const normalized = mdPath.replace(/\\/g, '/').replace(/^docs\//, '');
  const parts = normalized.split('/');
  const file = parts[parts.length - 1].toLowerCase();
  if (file === 'readme.md') {
    const dir = parts.slice(0, -1).join('/');
    return dir ? `/${dir}/` : '/';
  }
  return `/${normalized.replace(/\.md$/i, '')}`;
}
---

<aside id="sidebar">
  <div id="sidebar-header">
    <h1>☁️ AWS re/Start</h1>
    <p>Portfolio Navigator</p>
  </div>

  <nav id="nav">
    <a href="/" class="nav-item">
      <span class="icon">📍</span>
      <span>Home</span>
    </a>

    {nav.sections.map((section) => (
      <details class="nav-section" open>
        <summary class="nav-section-header">
          {section.icon && <span class="icon">{section.icon}</span>}
          <span>{section.label}</span>
          <span class="chevron">›</span>
        </summary>
        <div class="nav-section-body">
          {section.overview && (
            <div class="nav-leaf">
              <a href={mdToHref(section.overview)} class="nav-item">Overview</a>
            </div>
          )}

          {(section.entries ?? []).map((entry) => (
            <div class="nav-leaf">
              <a href={mdToHref(`${entry.path}/README.md`)} class="nav-item">{entry.label}</a>
            </div>
          ))}

          {(section.children ?? []).map((child) => (
            <details class="nav-sub-section" open>
              <summary class="nav-sub-header">
                {child.icon && <span class="icon">{child.icon}</span>}
                <span>{child.label}</span>
                <span class="chevron">›</span>
              </summary>
              <div class="nav-sub-body">
                {child.overview && (
                  <div class="nav-leaf">
                    <a href={mdToHref(child.overview)} class="nav-item">Overview</a>
                  </div>
                )}
                {(child.entries ?? []).map((entry) => (
                  <div class="nav-leaf">
                    <a href={mdToHref(`${entry.path}/README.md`)} class="nav-item">{entry.label}</a>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </details>
    ))}
  </nav>
</aside>
