---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllDocs } from '../lib/content.mjs';

export function getStaticPaths() {
  return getAllDocs()
    .filter((doc) => doc.urlPath !== '/')
    .map((doc) => {
      const slug = doc.urlPath.replace(/^\//, '').replace(/\/$/, '');
      return {
        params: { slug },
        props: { doc }
      };
    });
}

const { doc } = Astro.props;
---

<BaseLayout title={doc.title} description={doc.description}>
  <div set:html={doc.html} />
</BaseLayout>
