---
layout: null
---
[
  {% assign all_pages = site.pages | concat: site.documents | where_exp: "item", "item.title != nil" %}
  {% for page in all_pages %}
  {
    "title"    : "{{ page.title | escape }}",
    "url"      : "{{ page.url | relative_url }}",
    "category" : "{{ page.category }}",
    "tags"     : "{{ page.tags | join: ', ' }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
